<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:windowBackground"
    tools:context=".activities.CheckUpdateActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Smartisan page header: white bar, centered ink title, back arrow, hairline below -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:background="?colorPrimary"
            android:elevation="0dp"
            android:theme="@style/ThemeOverlay.Syncthing.Toolbar">

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/check_for_updates_title"
                android:textColor="@color/sm_ink"
                android:textSize="19sp"
                android:textStyle="bold" />

        </com.google.android.material.appbar.MaterialToolbar>

        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="@color/sm_hairline" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="24dp">

                <!-- Inline status: checking / up-to-date / failed / downloading -->
                <TextView
                    android:id="@+id/tvCheckStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/sm_value_gray"
                    android:textSize="13.5sp"
                    android:visibility="gone"
                    tools:text="正在检查更新…" />

                <!-- Content shown when an update is available -->
                <LinearLayout
                    android:id="@+id/updateContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Card 1: current → latest version comparison -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_list_card"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="18dp"
                        android:paddingBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/check_update_current"
                                    android:textColor="@color/sm_ink_weak"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvCurrentVersion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:textColor="@color/sm_value_gray"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    tools:text="v2.1.1" />

                            </LinearLayout>

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:rotation="180"
                                android:src="@drawable/baseline_arrow_back_24"
                                android:tint="@color/sm_chevron" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/check_update_latest"
                                    android:textColor="@color/sm_ink_weak"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvLatestVersion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:textColor="@color/sm_green_text"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    tools:text="v2.1.2" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvUpdateMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:textColor="@color/sm_ink_weak"
                            android:textSize="12sp"
                            tools:text="版本代码 63" />

                    </LinearLayout>

                    <!-- Card 2: changelog -->
                    <LinearLayout
                        android:id="@+id/changelogCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_list_card"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/check_update_changelog"
                            android:textColor="@color/sm_ink_weak"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:id="@+id/changelogContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                    <!-- Actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/btnDownload"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_btn_accent"
                            android:gravity="center"
                            android:text="@string/update_download"
                            android:textColor="#232D12"
                            android:textSize="15.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnLater"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="?selectableItemBackground"
                            android:gravity="center"
                            android:text="@string/update_later"
                            android:textColor="@color/sm_ink_weak"
                            android:textSize="13.5sp" />

                    </LinearLayout>

                    <!-- Trust footnote -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_sm_shield"
                            android:tint="@color/sm_chevron" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/check_update_trust_note"
                            android:textColor="@color/sm_chevron"
                            android:textSize="11.5sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</FrameLayout>
